# Get yours at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# Filled in after scripts/create_agent.py runs
AGENT_ID=

# Public HTTPS base URL of the booking API.
# AssemblyAI calls this directly from its servers, so localhost will NOT work.
# Dev:  cloudflared tunnel --url http://localhost:8000
# Prod: your Render / Railway / Fly URL
PUBLIC_API_BASE_URL=

# Optional — Discord Webhook URL for post-call executive dossier cards.
# How to get one:
#   Discord > your server > channel > Settings > Integrations > Webhooks > New Webhook > Copy URL
# Leave empty to disable Discord alerts. The rest of OmniDesk works without it.
DISCORD_WEBHOOK_URL=