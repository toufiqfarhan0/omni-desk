# ==============================================================================
# OmniDesk Voice Agent — Environment Variables (.env)
# ==============================================================================

# [REQUIRED] AssemblyAI API Key
# Get yours from the AssemblyAI Console: https://www.assemblyai.com/dashboard
NEXT_ASSEMBLYAI_API_KEY=

# [OPTIONAL] AssemblyAI Voice Agent ID
# Automatically created when deploying via the Agent Builder dashboard,
# or paste an existing agent ID from your AssemblyAI dashboard.
AGENT_ID=

# [OPTIONAL] Public HTTPS Base URL for AssemblyAI Webhook Tools
# AssemblyAI cloud calls your tools over HTTPS.
# For local dev: cloudflared tunnel --url http://localhost:3000
# For production: https://your-deployment-domain.com
PUBLIC_API_BASE_URL=

# [OPTIONAL] Free Gmail SMTP (Deliver to ANY email in the world — 0 domain required!)
# Set up in 1 min: Google Account > Security > 2-Step Verification > App Passwords
SMTP_USER=omni.desk.com@gmail.com
SMTP_PASS=

# [OPTIONAL] Supabase Cloud Database (Required for cloud deployment / Vercel)
# Get yours at https://supabase.com
# For local judges: Leave blank to use zero-setup SQLite ('data/omnidesk.db').
# For production/deployment: Populates Supabase PostgreSQL directly!
SUPABASE_URL=
SUPABASE_ANON_KEY=