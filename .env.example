# ==============================================================================
# OmniDesk Voice Agent — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.
# ==============================================================================

# [REQUIRED] AssemblyAI API Key
# Get yours from the AssemblyAI Console: https://www.assemblyai.com/dashboard
NEXT_ASSEMBLYAI_API_KEY=

# [REQUIRED FOR INSTANT DEMO & LIVE TESTER]
# Provide an existing AssemblyAI Voice Agent ID so calls work immediately out-of-the-box.
# If left blank, you must click "Deploy to AssemblyAI" in the dashboard before testing calls.
AGENT_ID=

# [ONLY NEEDED IF deploying a brand-new agent via the dashboard or running the update script]
# Public HTTPS base URL where AssemblyAI can reach your tool endpoints.
# ✅ JUDGES: Leave this BLANK. The pre-configured AGENT_ID above already has tools
#    pointing to the live Vercel deployment — no tunnel required for local testing.
# 🔧 Developers creating NEW agents: use a tunnel for local dev, or set your domain for prod.
#    Local tunnel example: cloudflared tunnel --url http://localhost:3000
#    Production example:   https://your-domain.com
PUBLIC_API_BASE_URL=

# [REQUIRED FOR update-assemblyai-agents.mjs SCRIPT]
# Comma-separated list of AssemblyAI agent IDs to update.
# Example: AGENT_IDS=agent_abc123,agent_def456
AGENT_IDS=

# [OPTIONAL] Override the default demo business ID used by the update script.
# BIZ_ID=biz_demo_dental

# [OPTIONAL] Free Gmail SMTP (Deliver to ANY email in the world — 0 domain required!)
# Set up in 1 min: Google Account > Security > 2-Step Verification > App Passwords
SMTP_USER=
SMTP_PASS=

# [OPTIONAL] Supabase Cloud Database (Required for cloud deployment / Vercel)
# Get yours at https://supabase.com
# For local dev: Leave blank to use zero-setup SQLite ('data/omnidesk.db').
# For production/Vercel: Required — populates Supabase PostgreSQL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=