{
  "name": "omnidesk-voice",
  "version": "0.1.5",
  "description": "Embeddable autonomous voice receptionist widget and client SDK for OmniDesk & AssemblyAI",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.mts",
        "default": "./dist/vanilla.mjs"
      },
      "require": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "assemblyai",
    "voice-agent",
    "receptionist",
    "voice-ai",
    "appointment-scheduler",
    "react-widget",
    "omnidesk"
  ],
  "author": "Toufiq Farhan",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.3.6",
    "typescript": "^5.7.0"
  }
}
